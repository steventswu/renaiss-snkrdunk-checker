# Copy this file to .env and use newly rotated credentials.
# Never commit .env.
RENAISS_API_KEY=replace_with_new_key
RENAISS_API_SECRET=replace_with_new_secret
# Find the extension ID at chrome://extensions after loading it unpacked.
RENAISS_ALLOWED_ORIGIN=chrome-extension://replace_with_extension_id
RENAISS_PROXY_PORT=8787
